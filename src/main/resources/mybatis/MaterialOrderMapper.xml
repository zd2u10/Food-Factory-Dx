<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/mybatis-3/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.foodfactory.dx.mapper.MaterialOrderMapper">

    <resultMap id="orderResultMap" type="com.foodfactory.dx.domain.MaterialOrder">
        <id column="order_id" property="orderId"/>
        <result column="material_id" property="materialId"/>
        <result column="supplier_id" property="supplierId"/>
        <result column="order_qty" property="orderQty"/>
        <result column="allowed_origins" property="allowedOrigins"/>
        <result column="order_date" property="orderDate"/>
        <result column="expected_date" property="expectedDate"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.foodfactory.dx.domain.MaterialOrder"
            useGeneratedKeys="true" keyProperty="orderId">
        INSERT INTO material_order (
            material_id, supplier_id, order_qty, allowed_origins, order_date, expected_date, status
        )
        VALUES (
            #{materialId}, #{supplierId}, #{orderQty}, #{allowedOrigins}, #{orderDate}, #{expectedDate}, #{status}
        )
    </insert>

    <select id="findById" resultMap="orderResultMap">
        SELECT * FROM material_order WHERE order_id = #{orderId}
    </select>

    <select id="findAll" resultMap="orderResultMap">
        SELECT * FROM material_order ORDER BY order_id
    </select>

    <update id="updateStatus">
        UPDATE material_order
        SET status = #{status}
        WHERE order_id = #{orderId}
    </update>

</mapper>
