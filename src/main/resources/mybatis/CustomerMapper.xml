<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/mybatis-3/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.foodfactory.dx.mapper.CustomerMapper">

    <resultMap id="customerResultMap" type="com.foodfactory.dx.domain.Customer">
        <id column="customer_id" property="customerId"/>
        <result column="name" property="name"/>
        <result column="customer_type" property="customerType"/>
        <result column="required_residual_days" property="requiredResidualDays"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.foodfactory.dx.domain.Customer"
            useGeneratedKeys="true" keyProperty="customerId">
        INSERT INTO customer (name, customer_type, required_residual_days)
        VALUES (#{name}, #{customerType}, #{requiredResidualDays})
    </insert>

    <select id="findById" resultMap="customerResultMap">
        SELECT * FROM customer WHERE customer_id = #{customerId}
    </select>

    <select id="findAll" resultMap="customerResultMap">
        SELECT * FROM customer ORDER BY customer_id
    </select>

    <update id="update" parameterType="com.foodfactory.dx.domain.Customer">
        UPDATE customer
        SET name                    = #{name},
            customer_type           = #{customerType},
            required_residual_days  = #{requiredResidualDays}
        WHERE customer_id = #{customerId}
    </update>

</mapper>
