<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/mybatis-3/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.foodfactory.dx.mapper.CustomerOrderMapper">

    <resultMap id="orderResultMap" type="com.foodfactory.dx.domain.CustomerOrder">
        <id column="order_id" property="orderId"/>
        <result column="customer_id" property="customerId"/>
        <result column="order_date" property="orderDate"/>
        <result column="desired_delivery_date" property="desiredDeliveryDate"/>
        <result column="status" property="status"/>
        <result column="external_order_no" property="externalOrderNo"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.foodfactory.dx.domain.CustomerOrder"
            useGeneratedKeys="true" keyProperty="orderId">
        INSERT INTO customer_order (customer_id, order_date, desired_delivery_date, status, external_order_no)
        VALUES (#{customerId}, #{orderDate}, #{desiredDeliveryDate}, #{status}, #{externalOrderNo})
    </insert>

    <select id="findById" resultMap="orderResultMap">
        SELECT * FROM customer_order WHERE order_id = #{orderId}
    </select>

    <select id="findAll" resultMap="orderResultMap">
        SELECT * FROM customer_order ORDER BY order_id
    </select>

    <update id="updateStatus">
        UPDATE customer_order
        SET status = #{status}
        WHERE order_id = #{orderId}
    </update>

</mapper>
