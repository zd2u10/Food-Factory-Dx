<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/mybatis-3/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.foodfactory.dx.mapper.MaterialPackageSpecMapper">

    <resultMap id="specResultMap" type="com.foodfactory.dx.domain.MaterialPackageSpec">
        <id column="spec_id" property="specId"/>
        <result column="material_id" property="materialId"/>
        <result column="origin" property="origin"/>
        <result column="package_weight" property="packageWeight"/>
        <result column="package_unit_label" property="packageUnitLabel"/>
        <result column="can_mix" property="canMix"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.foodfactory.dx.domain.MaterialPackageSpec"
            useGeneratedKeys="true" keyProperty="specId">
        INSERT INTO material_package_spec (material_id, origin, package_weight, package_unit_label, can_mix)
        VALUES (#{materialId}, #{origin}, #{packageWeight}, #{packageUnitLabel}, #{canMix})
    </insert>

    <select id="findById" resultMap="specResultMap">
        SELECT * FROM material_package_spec WHERE spec_id = #{specId}
    </select>

    <select id="findByMaterialId" resultMap="specResultMap">
        SELECT * FROM material_package_spec
        WHERE material_id = #{materialId}
        ORDER BY origin
    </select>

    <update id="update" parameterType="com.foodfactory.dx.domain.MaterialPackageSpec">
        UPDATE material_package_spec
        SET origin             = #{origin},
            package_weight     = #{packageWeight},
            package_unit_label = #{packageUnitLabel},
            can_mix            = #{canMix}
        WHERE spec_id = #{specId}
    </update>

    <delete id="deleteById">
        DELETE FROM material_package_spec WHERE spec_id = #{specId}
    </delete>

</mapper>
