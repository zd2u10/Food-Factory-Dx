<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/mybatis-3/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.foodfactory.dx.mapper.ShipmentLineMapper">

    <resultMap id="shipmentLineResultMap" type="com.foodfactory.dx.domain.ShipmentLine">
        <id column="line_id" property="lineId"/>
        <result column="shipment_id" property="shipmentId"/>
        <result column="order_line_id" property="orderLineId"/>
        <result column="batch_id" property="batchId"/>
        <result column="shipped_qty" property="shippedQty"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.foodfactory.dx.domain.ShipmentLine"
            useGeneratedKeys="true" keyProperty="lineId">
        INSERT INTO shipment_line (shipment_id, order_line_id, batch_id, shipped_qty)
        VALUES (#{shipmentId}, #{orderLineId}, #{batchId}, #{shippedQty})
    </insert>

    <select id="findByShipmentId" resultMap="shipmentLineResultMap">
        SELECT * FROM shipment_line WHERE shipment_id = #{shipmentId}
    </select>

    <select id="findByOrderLineId" resultMap="shipmentLineResultMap">
        SELECT * FROM shipment_line WHERE order_line_id = #{orderLineId}
    </select>

    <select id="sumShippedQtyByOrderLineId" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(shipped_qty), 0)
        FROM shipment_line
        WHERE order_line_id = #{orderLineId}
    </select>

    <select id="sumShippedQtyByOrderId" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(sl.shipped_qty), 0)
        FROM shipment_line sl
                 JOIN order_line ol ON sl.order_line_id = ol.line_id
        WHERE ol.order_id = #{orderId}
    </select>

    <select id="sumShippedQtyByItemId" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(sl.shipped_qty), 0)
        FROM shipment_line sl
                 JOIN order_line ol ON sl.order_line_id = ol.line_id
        WHERE ol.item_id = #{itemId}
    </select>

</mapper>
