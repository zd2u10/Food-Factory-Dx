<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/mybatis-3/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.foodfactory.dx.mapper.MaterialLotMapper">

    <resultMap id="lotResultMap" type="com.foodfactory.dx.domain.MaterialLot">
        <id column="lot_id" property="lotId"/>
        <result column="material_id" property="materialId"/>
        <result column="arrival_line_id" property="arrivalLineId"/>
        <result column="origin_hold_id" property="originHoldId"/>
        <result column="supplier_lot_no" property="supplierLotNo"/>
        <result column="origin" property="origin"/>
        <result column="expiry_date" property="expiryDate"/>
        <result column="remaining_qty" property="remainingQty"/>
        <result column="needs_review" property="needsReview"/>
        <result column="review_reason" property="reviewReason"/>
        <result column="review_comment" property="reviewComment"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.foodfactory.dx.domain.MaterialLot"
            useGeneratedKeys="true" keyProperty="lotId">
        INSERT INTO material_lot (material_id, arrival_line_id, origin_hold_id, supplier_lot_no, origin, expiry_date, remaining_qty)
        VALUES (#{materialId}, #{arrivalLineId}, #{originHoldId}, #{supplierLotNo}, #{origin}, #{expiryDate}, #{remainingQty})
    </insert>

    <select id="findById" resultMap="lotResultMap">
        SELECT * FROM material_lot WHERE lot_id = #{lotId}
    </select>

    <!--
      ORDER BY expiry_date ASC : 賞味期限が「近い(早い)」順に並べる指定。
      ASCは昇順(小さい値=日付が早いものが先頭)という意味で、
      これがそのままFEFO(期限が近いものを先に使う)の並び順になる。

      needs_review = FALSE : 製造実行画面で「別ロットに切り替える」操作が行われ、
      要確認フラグが立ったロットは、人が検査結果を登録するまで、
      自動選定の対象から除外する(要件定義書8.21節を参照)。
    -->
    <select id="findByMaterialIdOrderByExpiry" resultMap="lotResultMap">
        SELECT *
        FROM material_lot
        WHERE material_id = #{materialId}
          AND remaining_qty > 0
          AND needs_review = FALSE
        ORDER BY expiry_date ASC
    </select>

    <!-- 在庫画面向け: 全材料について、残量が残っているロットを一括取得する(要確認分も含む、
         画面側で要確認セクションと通常セクションに振り分けるため)。 -->
    <select id="findAllWithRemainingQty" resultMap="lotResultMap">
        SELECT *
        FROM material_lot
        WHERE remaining_qty > 0
        ORDER BY material_id ASC, expiry_date ASC
    </select>

    <update id="setRemainingQty">
        UPDATE material_lot
        SET remaining_qty = #{remainingQty}
        WHERE lot_id = #{lotId}
    </update>

    <select id="findByArrivalLineId" resultMap="lotResultMap">
        SELECT * FROM material_lot WHERE arrival_line_id = #{arrivalLineId}
    </select>

    <!-- 要確認フラグが立っているロットを、材料マスタと合わせて一覧取得する(在庫画面の要確認セクション用)。 -->
    <select id="findNeedsReview" resultMap="lotResultMap">
        SELECT * FROM material_lot WHERE needs_review = TRUE ORDER BY updated_at DESC
    </select>

    <!-- 「別ロットに切り替える」操作を行った際、そのロットに要確認フラグを立てる。 -->
    <update id="markNeedsReview">
        UPDATE material_lot
        SET needs_review   = TRUE,
            review_reason  = #{reviewReason},
            review_comment = #{reviewComment}
        WHERE lot_id = #{lotId}
    </update>

    <!--
      検査結果を登録し、要確認フラグを解除する。
      survivingQtyが指定された場合、remaining_qtyをその値に更新する
      (生存量をそのまま新しい残量として確定させる。廃棄された分は、
      Service層でstock_adjustmentに記録する)。
      survivingQtyがnullの場合(全量破棄)、remaining_qtyは0にする。
    -->
    <update id="resolveReview">
        UPDATE material_lot
        SET needs_review   = FALSE,
            remaining_qty  = #{survivingQty},
            review_reason  = NULL,
            review_comment = NULL
        WHERE lot_id = #{lotId}
    </update>

    <!--
      発注の充足率計算のうち、「結局受け入れ」(ACCEPTED_LATE)経由で生成された分を合算するためのクエリ。
      material_lot(origin_hold_id経由) → hold_resolution(line_id経由) → material_arrival_line(order_id)
      という3段階のJOINで、指定した発注に関わる「結局受け入れロット」の残量合計を求める。

      【重要】ここでは remaining_qty ではなく「受け入れた時点の量」を使うべきだが、
      material_lotにはその値を別途保持していないため、hold_resolution.held_qty_snapshot
      (保留になった時点で確定した、変動しない量)をJOIN先から取得して使う。
      remaining_qtyは製造で消費されると変動するため、充足率の計算には使わない
      (要件定義書8.17節を参照)。
    -->
    <select id="sumAcceptedLateQtyByOrderId" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(hr.held_qty_snapshot), 0)
        FROM material_lot ml
                 JOIN hold_resolution hr ON ml.origin_hold_id = hr.hold_id
                 JOIN material_arrival_line mal ON hr.line_id = mal.line_id
        WHERE mal.order_id = #{orderId}
    </select>

    <update id="incrementRemainingQty">
        UPDATE material_lot
        SET remaining_qty = remaining_qty + #{addQty}
        WHERE lot_id = #{lotId}
    </update>

    <!--
      remaining_qty = remaining_qty - #{usedQty} という「DB側での引き算」がポイント。
      Java側で事前に読み取った値を書き戻すのではなく、
      その瞬間のDB上の値に対して直接演算させることで、読み取りと書き込みの間に
      別の処理が割り込む余地(競合)を無くしている。

      WHERE句の remaining_qty >= #{usedQty} が無いと、
      在庫が足りない場合にマイナスの残量になってしまう。
      この条件があることで、在庫不足の場合はそもそも1件も更新されず(結果=0件)、
      呼び出し側でそれを検知してエラーにできる。
    -->
    <update id="decrementRemainingQty">
        UPDATE material_lot
        SET remaining_qty = remaining_qty - #{usedQty}
        WHERE lot_id = #{lotId}
          AND remaining_qty >= #{usedQty}
    </update>

</mapper>
