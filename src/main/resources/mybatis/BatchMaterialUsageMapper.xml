<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/mybatis-3/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.foodfactory.dx.mapper.BatchMaterialUsageMapper">

    <resultMap id="usageResultMap" type="com.foodfactory.dx.domain.BatchMaterialUsage">
        <id column="usage_id" property="usageId"/>
        <result column="batch_id" property="batchId"/>
        <result column="material_lot_id" property="materialLotId"/>
        <result column="suggested_qty" property="suggestedQty"/>
        <result column="used_qty" property="usedQty"/>
        <result column="usage_type" property="usageType"/>
        <result column="comment" property="comment"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.foodfactory.dx.domain.BatchMaterialUsage"
            useGeneratedKeys="true" keyProperty="usageId">
        INSERT INTO batch_material_usage (
            batch_id, material_lot_id, suggested_qty, used_qty, usage_type, comment
        )
        VALUES (
            #{batchId}, #{materialLotId}, #{suggestedQty}, #{usedQty}, #{usageType}, #{comment}
        )
    </insert>

    <select id="findByBatchId" resultMap="usageResultMap">
        SELECT * FROM batch_material_usage WHERE batch_id = #{batchId}
    </select>

</mapper>
